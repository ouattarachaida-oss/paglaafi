{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile --filter @workspace/mockup-sandbox... --filter workspace",
  "buildCommand": "pnpm run build",
  "outputDirectory": "artifacts/mockup-sandbox/dist",
  "regions": ["iad1"],
  "functions": {
    "api/rose-chat.ts": { "maxDuration": 30 },
    "api/supprimer-compte.ts": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
