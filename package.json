{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @workspace/mockup-sandbox run dev",
    "dev:mockup": "pnpm --filter @workspace/mockup-sandbox run dev",
    "dev:lan": "pnpm --filter @workspace/mockup-sandbox run dev:lan",
    "dev:mobile": "pnpm --filter @workspace/paglaafi run dev:local",
    "start": "pnpm --filter @workspace/mockup-sandbox run dev",
    "build:mockup": "pnpm --filter @workspace/mockup-sandbox run build",
    "build": "pnpm --filter @workspace/mockup-sandbox run build",
    "typecheck": "tsc -b tsconfig.json && pnpm --filter @workspace/mockup-sandbox run typecheck",
    "db:migrer": "node supabase/scripts/migrer.mjs",
    "db:superadmin": "node supabase/scripts/promouvoir-superadmin.mjs",
    "db:test-rls": "node supabase/tests/rls.test.mjs",
    "test:rose": "node --import tsx --test \"artifacts/mockup-sandbox/serveur/rose/tests/*.test.ts\"",
    "rag:indexer": "node --import tsx supabase/scripts/indexer-fiches.mjs",
    "rag:calibrer": "node --import tsx supabase/scripts/calibrer-seuil.mjs",
    "rag:faq": "node --import tsx supabase/scripts/indexer-fiches.mjs --faq",
    "test:rose-pieges": "node --import tsx supabase/tests/rose-pieges.test.mjs"
  },
  "private": true,
  "devDependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "tsx": "catalog:"
  }
}
