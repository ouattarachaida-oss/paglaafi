# Secrets côté serveur uniquement (migrations, Edge Functions) : ne jamais les exposer au navigateur.
# Copier ce fichier en .env puis renseigner les valeurs.

# Clé secrète Supabase (Project Settings > API > secret key)
SUPABASE_SECRET_KEY=
# Mot de passe de la base Postgres (à encoder en URL s'il est utilisé dans une chaîne de connexion)
SUPABASE_DB_PASSWORD=
# Adresse du « session pooler » (Project Settings > Database > Connection string > Session pooler),
# SANS le mot de passe : les scripts y insèrent SUPABASE_DB_PASSWORD encodé.
# ex. postgresql://postgres.<ref>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_POOLER_URL=
