# Variables publiques de l'application (exposées au navigateur par Vite : préfixe VITE_)
# Copier ce fichier en .env puis renseigner les valeurs (Supabase > Project Settings > API).

# URL du projet Supabase (ex. https://xxxx.supabase.co)
VITE_SUPABASE_URL=
# Clé publiable (publishable / anon) : protégée par les règles RLS, jamais la clé secrète ici
VITE_SUPABASE_PUBLISHABLE_KEY=
# true : accès démo rapides et bandeau « Démo » ; false : mode réel uniquement
VITE_MODE_DEMO=true
